# 목적: 로컬/배포 환경에서 필요한 환경변수 이름을 팀과 공유하기 위한 양식
# 왜: 실제 비밀값(.env)은 git에 올리면 안 되므로, 값이 빈 사본을 대신 공유함
# 무엇: 이 파일을 복사해 .env로 만든 뒤, 비어있는 값만 각자 채워서 사용
# 사용법: cp .env.example .env

PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=iksanshop

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

SESSION_SECRET=

# #136 인기 검색어: search_logs.client_hash 계산용 salt. IP/user_id 원본 대신 해시만 저장하기 위함.
SEARCH_LOG_HASH_SALT=

# #121 초기 요청 제한(전체 요청 집계, 단일 프로세스 메모리). 필요 시 운영 검토 후 조정.
# 로그인 IP당 15분, 가입 IP당 1시간, 문의/신고 등록 회원별 각각 10분
RATE_LIMIT_LOGIN_MAX=100
RATE_LIMIT_SIGNUP_MAX=30
RATE_LIMIT_INQUIRY_MAX=60
RATE_LIMIT_REPORT_MAX=60
# 닉네임 검색(회원용/관리자용) 회원별 10분. 닉네임 존재 여부를 무제한으로 확인하는
# 열거(enumeration) 통로를 막기 위함.
RATE_LIMIT_SEARCH_MAX=60
# #136 인기 검색어: 상품 검색(keyword 있을 때만) 회원/IP별 10분. 닉네임 검색과는 별개 카운터.
RATE_LIMIT_PRODUCT_SEARCH_MAX=60
